# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (MySQL 8) — used once backend API routes are added ─────────
# DATABASE_URL="mysql://user:pass@host:3306/vesper"

# ─── Auth (Clerk recommended) ────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# ─── Stripe (billing) ────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ─── Object storage (Cloudflare R2) ──────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="vesper-documents"
# R2_PUBLIC_BASE_URL=""

# NOTE: The frontend runs today on mock data (src/lib/data.ts) with NO env vars.
# The commented values above are needed only when you wire the backend API routes
# into this app — see ../backend/docs/BACKEND_ARCHITECTURE.md.
