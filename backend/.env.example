# ─── Database ────────────────────────────────────────────────────────────────
# MySQL 8. Example: mysql://user:pass@host:3306/vesper
DATABASE_URL="mysql://root:password@localhost:3306/vesper"

# ─── Auth (choose one provider) ──────────────────────────────────────────────
# Clerk (recommended for Phase 1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# …or Auth.js
# AUTH_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── Object storage (Cloudflare R2, S3-compatible) ───────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vesper-documents"
R2_PUBLIC_BASE_URL=""   # e.g. https://docs.vesper.ai (CDN/public bucket base)

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""   # price_… for the Starter plan
STRIPE_PRICE_GROWTH=""    # price_… for the Growth plan

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Intentionally NOT in Phase 1 ────────────────────────────────────────────
# No Twilio / Exotel / Plivo / SIP, no Vapi/Retell, no ElevenLabs/Deepgram,
# no Redis, no vector DB. Those arrive in Phase 2 against the same schema.
